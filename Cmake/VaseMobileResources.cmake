# 从本次选择的 STATIC 包属性生成资源名与进程内绑定，无独立手抄成员表。
function(vase_generate_mobile_resources outputFile)
    cmake_parse_arguments(RES "" "" "PACKAGES" ${ARGN})
    if(NOT RES_PACKAGES)
        message(FATAL_ERROR "vase_generate_mobile_resources: PACKAGES cannot be empty")
    endif()

    set(VASE_MOBILE_RESOURCE_ITEMS "")
    set(VASE_MOBILE_BINDING_ITEMS "")
    set(VASE_MOBILE_ENTRY_INCLUDES "")
    set(resourceHeaderDirs "")
    set(sourceIds "")
    set(count 0)
    foreach(package IN LISTS RES_PACKAGES)
        if(NOT TARGET ${package})
            message(FATAL_ERROR "vase_generate_mobile_resources: missing package ${package}")
        endif()
        get_target_property(sourceId ${package} VASE_MOBILE_SOURCE_ID)
        get_target_property(packKind ${package} VASE_PACK_KIND)
        get_target_property(entryHeader ${package} VASE_PACK_HEADER)
        get_target_property(entryNamespace ${package} VASE_PACK_ENTRY_NAMESPACE)
        if(NOT sourceId OR NOT sourceId MATCHES "^[A-Za-z0-9_-]+$" OR sourceId IN_LIST sourceIds)
            message(FATAL_ERROR "vase_generate_mobile_resources: invalid or duplicate source id on ${package}")
        endif()
        if(NOT packKind STREQUAL "STATIC" OR NOT entryHeader OR NOT entryNamespace)
            message(FATAL_ERROR "vase_generate_mobile_resources: ${package} must be a STATIC package with entries")
        endif()
        list(APPEND sourceIds "${sourceId}")
        get_filename_component(entryFile "${entryHeader}" NAME)
        get_filename_component(entryDir "${entryHeader}" DIRECTORY)
        list(APPEND resourceHeaderDirs "${entryDir}")
        string(APPEND VASE_MOBILE_ENTRY_INCLUDES "#include \"${entryFile}\"\n")
        string(APPEND VASE_MOBILE_RESOURCE_ITEMS
            "    vase_mobile::PackageResourceName{.AssetName = \"vase/${sourceId}/pack.json\", .SourceId = \"${sourceId}\"},\n")
        string(APPEND VASE_MOBILE_BINDING_ITEMS
            "    vase::InProcessBinding{.SourceId = \"${sourceId}\", .Entries = ${entryNamespace}::kEntryPoints},\n")
        math(EXPR count "${count} + 1")
    endforeach()
    list(REMOVE_DUPLICATES resourceHeaderDirs)
    set(VASE_MOBILE_RESOURCE_COUNT "${count}")
    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/VaseMobileResources.h.in" "${outputFile}" @ONLY)
    set(VASE_MOBILE_RESOURCE_HEADER_DIRS "${resourceHeaderDirs}" PARENT_SCOPE)
endfunction()
