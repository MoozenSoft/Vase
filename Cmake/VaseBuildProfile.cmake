# profile 与依赖选择必须早于 project()，目标系统则等真实工具链载入后检查。
set(VASE_BUILD_PROFILE desktop CACHE STRING "Vase build profile")
set_property(CACHE VASE_BUILD_PROFILE PROPERTY STRINGS desktop manifest-host mobile)
if(NOT VASE_BUILD_PROFILE MATCHES "^(desktop|manifest-host|mobile)$")
    message(FATAL_ERROR "VASE_BUILD_PROFILE '${VASE_BUILD_PROFILE}' 无效：请选择 desktop / manifest-host / mobile")
endif()
# 引入 profile 之前已配置过的构建树也是 desktop，不能借迁移窗口切换形态。
if(NOT DEFINED VASE_CONFIGURED_PROFILE AND DEFINED CMAKE_PROJECT_NAME)
    set(VASE_CONFIGURED_PROFILE desktop CACHE INTERNAL "Initial Vase profile")
endif()
if(DEFINED VASE_CONFIGURED_PROFILE AND NOT VASE_CONFIGURED_PROFILE STREQUAL VASE_BUILD_PROFILE)
    message(FATAL_ERROR
        "Vase profile 不允许在同一构建树从 ${VASE_CONFIGURED_PROFILE} 切换为 ${VASE_BUILD_PROFILE}；请使用新构建树")
endif()
set(VASE_CONFIGURED_PROFILE "${VASE_BUILD_PROFILE}" CACHE INTERNAL "Initial Vase profile")
if(NOT VASE_BUILD_PROFILE STREQUAL "desktop")
    set(VCPKG_MANIFEST_NO_DEFAULT_FEATURES ON CACHE BOOL "Disable desktop dependencies" FORCE)
    if("desktop-tests" IN_LIST VCPKG_MANIFEST_FEATURES)
        message(FATAL_ERROR "${VASE_BUILD_PROFILE}: desktop-tests feature 不适用于静态发布构建")
    endif()
endif()

function(vase_validate_build_profile)
    if(VASE_BUILD_PROFILE STREQUAL "mobile")
        if(NOT CMAKE_SYSTEM_NAME MATCHES "^(Android|iOS)$")
            message(FATAL_ERROR "mobile profile 只允许 Android / iOS 真实工具链，当前为 ${CMAKE_SYSTEM_NAME}")
        endif()
    elseif(VASE_BUILD_PROFILE STREQUAL "manifest-host")
        if(CMAKE_CROSSCOMPILING OR CMAKE_SYSTEM_NAME MATCHES "^(Android|iOS)$")
            message(FATAL_ERROR "manifest-host profile 只允许宿主原生平台，当前为 ${CMAKE_SYSTEM_NAME}")
        endif()
    endif()
endfunction()

set(VASE_FRAMEWORK_LINKAGE SHARED)
if(NOT VASE_BUILD_PROFILE STREQUAL "desktop")
    set(VASE_FRAMEWORK_LINKAGE STATIC)
endif()
