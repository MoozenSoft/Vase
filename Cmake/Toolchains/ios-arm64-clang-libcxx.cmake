# Real iPhoneOS arm64 target; never substitute macOS SDK, simulator or Xcode.
if(NOT DEFINED ENV{VASE_IOS_SDK_ROOT} OR "$ENV{VASE_IOS_SDK_ROOT}" STREQUAL "")
    message(FATAL_ERROR "iOS mobile: set VASE_IOS_SDK_ROOT to an extracted iPhoneOS18.2.sdk")
endif()
set(iosSdk "$ENV{VASE_IOS_SDK_ROOT}")
if(NOT EXISTS "${iosSdk}/SDKSettings.plist" OR
   NOT EXISTS "${iosSdk}/usr/lib/libSystem.tbd" OR
   NOT iosSdk MATCHES "iPhoneOS18\\.2\\.sdk/?$")
    message(FATAL_ERROR "iOS mobile: expected real iPhoneOS18.2.sdk with SDKSettings.plist/libSystem.tbd: ${iosSdk}")
endif()
if(NOT DEFINED ENV{VCPKG_ROOT} OR "$ENV{VCPKG_ROOT}" STREQUAL "")
    message(FATAL_ERROR "iOS mobile: VCPKG_ROOT not set")
endif()
find_program(VASE_IOS_CLANGXX NAMES clang++-mp-23 REQUIRED)
find_program(VASE_IOS_CLANG NAMES clang-mp-23 REQUIRED)
set(CMAKE_SYSTEM_NAME iOS)
set(CMAKE_OSX_SYSROOT "${iosSdk}" CACHE PATH "True iPhoneOS18.2 SDK" FORCE)
set(CMAKE_OSX_ARCHITECTURES arm64 CACHE STRING "Device target only" FORCE)
set(CMAKE_OSX_DEPLOYMENT_TARGET 15.0 CACHE STRING "Minimum iPhoneOS version" FORCE)
set(CMAKE_C_COMPILER "${VASE_IOS_CLANG}" CACHE FILEPATH "Cross C compiler" FORCE)
set(CMAKE_CXX_COMPILER "${VASE_IOS_CLANGXX}" CACHE FILEPATH "Cross C++ compiler" FORCE)
set(CMAKE_C_COMPILER_TARGET arm64-apple-ios15.0)
set(CMAKE_CXX_COMPILER_TARGET arm64-apple-ios15.0)
set(VCPKG_OVERLAY_TRIPLETS "${CMAKE_CURRENT_LIST_DIR}/../Triplets")
set(VCPKG_TARGET_TRIPLET arm64-ios-libcxx)
include("$ENV{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake")
