# Stage exactly the selected resources into the iPhoneOS build-tree app bundle.
foreach(required IN ITEMS VASE_IOS_APP_BUNDLE)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "VaseMobileIosBundleAssets: missing ${required}")
    endif()
endforeach()

# Recover a publication interrupted after moving the prior bundle aside.
# This must precede source validation: a missing next candidate must never
# leave the last usable bundle stranded under the backup name.
set(active "${VASE_IOS_APP_BUNDLE}/vase")
set(previous "${VASE_IOS_APP_BUNDLE}/.vase-resources-previous")
if(EXISTS "${previous}" AND NOT EXISTS "${active}")
    file(RENAME "${previous}" "${active}" RESULT recovered)
    if(NOT recovered STREQUAL "0")
        message(FATAL_ERROR "VaseMobileIosBundleAssets: cannot recover old bundle: ${recovered}")
    endif()
endif()
# Recovery must be callable before host candidate generation or native linking.
if(DEFINED VASE_IOS_RECOVER_ONLY AND VASE_IOS_RECOVER_ONLY)
    message(STATUS "VaseMobileIosBundleAssets recovered prior interrupted bundle")
    return()
endif()
foreach(required IN ITEMS VASE_IOS_HOST_BUILD VASE_IOS_SOURCE_IDS)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "VaseMobileIosBundleAssets: missing ${required}")
    endif()
endforeach()

string(REPLACE "|" ";" sourceIds "${VASE_IOS_SOURCE_IDS}")
set(seenIds "")
foreach(sourceId IN LISTS sourceIds)
    if(NOT sourceId MATCHES "^[A-Za-z0-9_-]+$" OR sourceId IN_LIST seenIds)
        message(FATAL_ERROR "VaseMobileIosBundleAssets: invalid or duplicate sourceId ${sourceId}")
    endif()
    list(APPEND seenIds "${sourceId}")
    set(candidate "${VASE_IOS_HOST_BUILD}/mobile-resources/vase/${sourceId}/pack.json")
    if(NOT EXISTS "${candidate}")
        message(FATAL_ERROR "VaseMobileIosBundleAssets: missing generated candidate ${candidate}")
    endif()
endforeach()

# Assemble first; a missing candidate must leave the last valid bundle untouched.
set(staged "${VASE_IOS_APP_BUNDLE}/.vase-resources-next")
file(REMOVE_RECURSE "${staged}")
file(MAKE_DIRECTORY "${staged}")
foreach(sourceId IN LISTS sourceIds)
    file(MAKE_DIRECTORY "${staged}/${sourceId}")
    file(COPY_FILE "${VASE_IOS_HOST_BUILD}/mobile-resources/vase/${sourceId}/pack.json"
        "${staged}/${sourceId}/pack.json")
endforeach()
# When active exists too, the prior install reached its publish step;
# only this case may discard the leftover backup before a new publish.
if(EXISTS "${previous}")
    file(REMOVE_RECURSE "${previous}")
endif()
if(EXISTS "${active}")
    file(RENAME "${active}" "${previous}" RESULT saved)
    if(NOT saved STREQUAL "0")
        message(FATAL_ERROR "VaseMobileIosBundleAssets: cannot preserve old bundle: ${saved}")
    endif()
endif()
file(RENAME "${staged}" "${active}" RESULT published)
if(NOT published STREQUAL "0")
    if(EXISTS "${previous}")
        file(RENAME "${previous}" "${active}" RESULT restored)
        if(NOT restored STREQUAL "0")
            message(FATAL_ERROR "VaseMobileIosBundleAssets: publish and rollback failed: ${published}; ${restored}")
        endif()
    endif()
    message(FATAL_ERROR "VaseMobileIosBundleAssets: publish failed: ${published}")
endif()
file(REMOVE_RECURSE "${previous}")
message(STATUS "iPhoneOS selected resources staged from native host build into ${VASE_IOS_APP_BUNDLE}")
