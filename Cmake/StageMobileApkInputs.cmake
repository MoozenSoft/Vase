# Build-tree APK staging. Assets and JNI are one recoverable publication.
if(NOT DEFINED VASE_MOBILE_OUTPUT OR "${VASE_MOBILE_OUTPUT}" STREQUAL "")
    message(FATAL_ERROR "VaseMobileApkInputs: required argument VASE_MOBILE_OUTPUT missing")
endif()
set(assetsDestination "${VASE_MOBILE_OUTPUT}/assets/vase")
set(jniDestination "${VASE_MOBILE_OUTPUT}/jniLibs/arm64-v8a")
set(stageRoot "${VASE_MOBILE_OUTPUT}/.vase-next")
set(marker "${VASE_MOBILE_OUTPUT}/.vase-publish-phase")

function(restore_backup destination hadOriginal)
    set(backup "${destination}.vase-previous")
    if(hadOriginal)
        if(EXISTS "${backup}")
            if(EXISTS "${destination}")
                file(REMOVE_RECURSE "${destination}")
                if(EXISTS "${destination}")
                    message(FATAL_ERROR
                        "VaseMobileApkInputs: rollback cannot remove published ${destination}; marker retained")
                endif()
            endif()
            file(RENAME "${backup}" "${destination}" RESULT restored)
            if(NOT restored STREQUAL "0")
                message(FATAL_ERROR "VaseMobileApkInputs: cannot recover ${destination}: ${restored}")
            endif()
        elseif(NOT EXISTS "${destination}")
            message(FATAL_ERROR "VaseMobileApkInputs: original and backup both missing: ${destination}")
        endif()
    else()
        if(EXISTS "${backup}")
            message(FATAL_ERROR "VaseMobileApkInputs: unexpected backup for absent destination: ${backup}")
        endif()
        if(EXISTS "${destination}")
            file(REMOVE_RECURSE "${destination}")
            if(EXISTS "${destination}")
                message(FATAL_ERROR
                    "VaseMobileApkInputs: rollback cannot remove new ${destination}; marker retained")
            endif()
        endif()
    endif()
endfunction()

function(recover_publication)
    if(EXISTS "${marker}")
        file(READ "${marker}" state)
        string(STRIP "${state}" state)
        if(NOT state MATCHES "^(rollback|committed)\\|([01])\\|([01])$")
            message(FATAL_ERROR "VaseMobileApkInputs: invalid transaction marker: ${state}")
        endif()
        set(phase "${CMAKE_MATCH_1}")
        set(hadAssets "${CMAKE_MATCH_2}")
        set(hadJni "${CMAKE_MATCH_3}")
        if(phase STREQUAL "rollback")
            restore_backup("${assetsDestination}" ${hadAssets})
            restore_backup("${jniDestination}" ${hadJni})
        elseif(NOT EXISTS "${assetsDestination}" OR NOT EXISTS "${jniDestination}")
            message(FATAL_ERROR "VaseMobileApkInputs: committed output missing, refusing mixed generations")
        endif()
        # Once committed, published directories win over any partial backups.
        file(REMOVE_RECURSE "${assetsDestination}.vase-previous"
            "${jniDestination}.vase-previous")
        # REMOVE_RECURSE may only warn about a locked/partially deleted tree.
        # Retain the phase marker until both backups are actually absent.
        if(EXISTS "${assetsDestination}.vase-previous" OR
           EXISTS "${jniDestination}.vase-previous")
            message(FATAL_ERROR "VaseMobileApkInputs: backup cleanup incomplete; transaction marker retained")
        endif()
        file(REMOVE "${marker}")
        if(EXISTS "${marker}")
            message(FATAL_ERROR "VaseMobileApkInputs: cannot remove completed transaction marker")
        endif()
    else()
        # A legacy release without a marker is ambiguous when both published
        # destinations coexist with backup(s): cleanup may have removed only
        # one old generation. Fail closed rather than silently mix versions.
        set(hasAssetsBackup FALSE)
        set(hasJniBackup FALSE)
        if(EXISTS "${assetsDestination}.vase-previous")
            set(hasAssetsBackup TRUE)
        endif()
        if(EXISTS "${jniDestination}.vase-previous")
            set(hasJniBackup TRUE)
        endif()
        if((hasAssetsBackup AND EXISTS "${assetsDestination}" AND NOT hasJniBackup) OR
           (hasJniBackup AND EXISTS "${jniDestination}" AND NOT hasAssetsBackup) OR
           ((hasAssetsBackup OR hasJniBackup) AND
            EXISTS "${assetsDestination}" AND EXISTS "${jniDestination}"))
            message(FATAL_ERROR
                "VaseMobileApkInputs: ambiguous markerless legacy backup; refusing mixed generations")
        endif()
        # Unambiguous legacy interruption: active absent and backup intact.
        foreach(destination IN ITEMS "${assetsDestination}" "${jniDestination}")
            set(backup "${destination}.vase-previous")
            if(EXISTS "${backup}")
                if(EXISTS "${destination}")
                    file(REMOVE_RECURSE "${destination}")
                endif()
                file(RENAME "${backup}" "${destination}" RESULT recovered)
                if(NOT recovered STREQUAL "0")
                    message(FATAL_ERROR "VaseMobileApkInputs: cannot recover ${destination}: ${recovered}")
                endif()
            endif()
        endforeach()
    endif()
endfunction()

# Called before native/host candidate build dependencies; candidate failure
# must not prevent recovery of the prior valid APK generation.
recover_publication()
if(DEFINED VASE_MOBILE_RECOVER_ONLY AND VASE_MOBILE_RECOVER_ONLY)
    message(STATUS "VaseMobileApkInputs recovered interrupted publication")
    return()
endif()

foreach(required IN ITEMS VASE_MOBILE_JNI VASE_MOBILE_STL VASE_MOBILE_HOST VASE_MOBILE_SOURCES)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "VaseMobileApkInputs: required argument ${required} missing")
    endif()
endforeach()
foreach(input IN ITEMS "${VASE_MOBILE_JNI}" "${VASE_MOBILE_STL}")
    if(NOT EXISTS "${input}")
        message(FATAL_ERROR "VaseMobileApkInputs: missing shared library: ${input}")
    endif()
endforeach()
string(REPLACE "|" ";" sourceIds "${VASE_MOBILE_SOURCES}")
set(seenIds "")
foreach(sourceId IN LISTS sourceIds)
    if(NOT sourceId MATCHES "^[A-Za-z0-9_-]+$" OR sourceId IN_LIST seenIds)
        message(FATAL_ERROR "VaseMobileApkInputs: invalid or duplicate package SourceId ${sourceId}")
    endif()
    list(APPEND seenIds "${sourceId}")
    set(candidate "${VASE_MOBILE_HOST}/mobile-resources/vase/${sourceId}/pack.json")
    if(NOT EXISTS "${candidate}")
        message(FATAL_ERROR "VaseMobileApkInputs: missing native staged candidate ${candidate}")
    endif()
endforeach()

# Assemble all new content before any published directory is touched.
file(REMOVE_RECURSE "${stageRoot}")
file(MAKE_DIRECTORY "${stageRoot}/jniLibs/arm64-v8a" "${stageRoot}/assets/vase")
file(COPY_FILE "${VASE_MOBILE_JNI}" "${stageRoot}/jniLibs/arm64-v8a/libVaseMobileJni.so")
file(COPY_FILE "${VASE_MOBILE_STL}" "${stageRoot}/jniLibs/arm64-v8a/libc++_shared.so")
foreach(sourceId IN LISTS sourceIds)
    file(MAKE_DIRECTORY "${stageRoot}/assets/vase/${sourceId}")
    file(COPY_FILE "${VASE_MOBILE_HOST}/mobile-resources/vase/${sourceId}/pack.json"
        "${stageRoot}/assets/vase/${sourceId}/pack.json")
endforeach()

function(install_owned_directory staged destination outError)
    set(backup "${destination}.vase-previous")
    if(EXISTS "${destination}")
        file(RENAME "${destination}" "${backup}" RESULT saved)
        if(NOT saved STREQUAL "0")
            set(${outError} "cannot preserve ${destination}: ${saved}" PARENT_SCOPE)
            return()
        endif()
    endif()
    file(RENAME "${staged}" "${destination}" RESULT published)
    if(NOT published STREQUAL "0")
        set(${outError} "cannot publish ${destination}: ${published}" PARENT_SCOPE)
        return()
    endif()
    set(${outError} "" PARENT_SCOPE)
endfunction()

file(MAKE_DIRECTORY "${VASE_MOBILE_OUTPUT}/assets" "${VASE_MOBILE_OUTPUT}/jniLibs")
set(hadAssets 0)
set(hadJni 0)
if(EXISTS "${assetsDestination}")
    set(hadAssets 1)
endif()
if(EXISTS "${jniDestination}")
    set(hadJni 1)
endif()
# Write-ahead rollback marker before the first directory rename.
file(WRITE "${marker}.tmp" "rollback|${hadAssets}|${hadJni}\n")
file(RENAME "${marker}.tmp" "${marker}" RESULT marked)
if(NOT marked STREQUAL "0")
    message(FATAL_ERROR "VaseMobileApkInputs: cannot start publication: ${marked}")
endif()

install_owned_directory("${stageRoot}/assets/vase" "${assetsDestination}" firstError)
if(NOT firstError STREQUAL "")
    recover_publication()
    message(FATAL_ERROR "VaseMobileApkInputs: ${firstError}")
endif()
install_owned_directory("${stageRoot}/jniLibs/arm64-v8a" "${jniDestination}" secondError)
if(NOT secondError STREQUAL "")
    recover_publication()
    message(FATAL_ERROR "VaseMobileApkInputs: ${secondError}; restored previous assets")
endif()

# Durable commit *before* deleting backups. An interrupted cleanup must
# preserve both published directories, never restore just one partial backup.
file(WRITE "${marker}.tmp" "committed|${hadAssets}|${hadJni}\n")
file(RENAME "${marker}.tmp" "${marker}" RESULT committed)
if(NOT committed STREQUAL "0")
    recover_publication()
    message(FATAL_ERROR "VaseMobileApkInputs: cannot commit publication: ${committed}")
endif()
recover_publication()
file(REMOVE_RECURSE "${stageRoot}")
message(STATUS "VaseMobileApkInputs staged selected packages from build outputs: ${VASE_MOBILE_OUTPUT}")
