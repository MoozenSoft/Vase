# Vase — clang-tidy 配置
#
# 用法：
#   尚无编译数据库时：
#     clang-tidy <file> -- -std=c++20 -Iinclude
#   有 compile_commands.json 时（推荐）：
#     clang-tidy -p build/ <file>
#     run-clang-tidy -p build/ -fix
#
# 检查集取舍说明（列表本身见下方 Checks，此处不逐条内联注释
# —— folded block scalar ">" 内部的 "#" 不是注释而是字面内容）：
#   cert-err58-cpp            单独开启：静态初始化可能抛异常。插件以动态库形式加载，
#                             DSO 静态初始化失败难以捕获，值得单独盯。
#   -llvm-/google-/fuchsia-/altera-*  属于特定项目的编码风格，不适用。
#   -hicpp-*                  与 cppcoreguidelines-*/bugprone-* 大量重叠，会重复报同一条。
#   -modernize-use-trailing-return-type   主观偏好。
#   -readability-magic-numbers / -cppcoreguidelines-avoid-magic-numbers   噪声大于收益。
#                            这两项的禁用**已落实进下方 Checks**（原先只写在本说明里，列表漏了，
#                            导致 M0 的 0x56415345U 探针常量被报出来）。若日后要改为强制，
#                            正确做法是给常量起名（constexpr kCamelCase），而不是删这两条。
#   -clang-analyzer-optin.core.EnumCastOutOfRange
#                            本仓库首次用 <filesystem> 的取尺寸/时间（Tools/VaseConsole/Console.cpp:547）
#                            后被触发，诊断位置在 **MSVC 自己的 xfilesystem_abi.h:134**，不在我们的
#                            代码上。出路逐条试尽：任何走 `_Stat` 的 size/mtime 都触发；位置在厂商头里，
#                            就地 NOLINT 够不着；改用 directory_entry 更差（3 条）；ExcludeHeaderFilterRegex
#                            对正文诊断无效。既无代码级出路，整条关掉；本仓库其余地方不因此松口径。
#   -portability-avoid-pragma-once  本仓库头文件统一用 `#pragma once`（计划里的片段即如此），
#                            而目标编译器矩阵（clang-cl / cl.exe / clang / Apple clang）全都支持它。
#                            该检查针对的是矩阵之外的编译器，对本项目只产生噪声。
#   -readability-identifier-length / -readability-function-cognitive-complexity  主观。
#   -bugprone-easily-swappable-parameters  误报较多。
#   -misc-non-private-member-variables-in-classes  对聚合/简单 struct 误报。
#
# 下面四条**事实上是开启的**（说明里提到过，但 Checks 中没有对应的禁用项）。
# 2026-09-17 实测校正：旧文此处写「三者当下都不触发门禁」，与事实相反——
# 它们对 M1 代码真会触发，计划内已改为逐点规避代码写法（清单见
# docs/superpowers/plans/2026-09-16-vase-m1-pod-loop-hotswap.md 的「tidy 形态约束」）：
#   cppcoreguidelines-pro-bounds-*     指针减法 / 数组退化 / 非常量下标的 operator[]
#   cppcoreguidelines-pro-type-vararg  fprintf 一族
#   cppcoreguidelines-macro-usage      能写成函数就别写宏（source_location 已可替代 __FILE__）
#   misc-include-cleaner               仍未定夺：有编译数据库时报的是真问题
#                                      （缺 #include <cstdint>），方向与上三条相反
---
# 按类别分组：每组的启用通配在前，该组的禁用项紧随其后。
# 顺序有意义——clang-tidy 中后出现的模式覆盖先出现的，禁用必须在同组的启用之后。
Checks: >
  -*,

  bugprone-*,
  -bugprone-easily-swappable-parameters,

  clang-analyzer-*,
  -clang-analyzer-optin.core.EnumCastOutOfRange,

  concurrency-*,

  misc-*,
  -misc-non-private-member-variables-in-classes,

  modernize-*,
  -modernize-use-trailing-return-type,

  performance-*,

  portability-*,
  -portability-avoid-pragma-once,

  readability-*,
  -readability-identifier-length,
  -readability-function-cognitive-complexity,
  -readability-magic-numbers,

  cppcoreguidelines-*,
  -cppcoreguidelines-avoid-magic-numbers,

  cert-err58-cpp,

  -llvm-*,
  -google-*,
  -fuchsia-*,
  -altera-*,
  -hicpp-*,

# 保持为空：作为提示而非阻断。接 CI 后再决定哪些检查升级为 error
WarningsAsErrors: ''
HeaderFilterRegex: '.*'
# ThirdParty/ 下的第三方源码**不进**本仓库的检查口径。
#
# 为什么需要这一条：上面的 HeaderFilterRegex 是 `.*`，即"被包含进来的头也算正文"。
# ThirdParty/cli 是本仓库第一个**以普通 -I（而非 -isystem）进入编译的第三方头**——-I 是
# 故意的（它让"fork 不得带回 throw"这件事由编译器响亮报错，见 Cmake/VaseThirdParty.cmake），
# 代价就是这些头会吃到我们的 readability-identifier-naming 等检查（上游写的是 snake_case
# 与自由风格），Tools/VaseConsole/Shell.cpp 一进编译数据库，门禁就会破在第三方代码上。
#
# 写法用 `.*ThirdParty.*` 而不是 `ThirdParty/.*`：Windows 下 clang-tidy 拿到的路径分隔符
# 可能是反斜杠，带斜杠的字面量会不匹配。两边都要成立，所以不押分隔符。
# 已验（2026-09-22）：三条 tidy 线（clang-cl / cl.exe / Linux）的正文里 `ThirdParty/` 路径的
# diagnostic 均为 **0 条**，即本排除如期生效。
ExcludeHeaderFilterRegex: '.*ThirdParty.*'
# 让 clang-tidy --fix 使用本仓库的 .clang-format
FormatStyle: file

CheckOptions:
  readability-identifier-naming.NamespaceCase:                    lower_case
  readability-identifier-naming.ClassCase:                        CamelCase
  readability-identifier-naming.EnumCase:                         CamelCase
  readability-identifier-naming.EnumConstantCase:                 CamelCase
  readability-identifier-naming.EnumConstantPrefix:               k
  readability-identifier-naming.StructCase:                       CamelCase
  readability-identifier-naming.UnionCase:                        CamelCase
  readability-identifier-naming.TypedefCase:                      CamelCase 
  readability-identifier-naming.TemplateParameterCase:            CamelCase  # 兜底模板参数
  readability-identifier-naming.TemplateTemplateParameterCase:    CamelCase  # 模板模板参数，如 template<template<class> class Container>
  readability-identifier-naming.TypeTemplateParameterCase:        CamelCase  # 类型模板参数，如 template<typename T>
  readability-identifier-naming.ValueTemplateParameterCase:       CamelCase  # 非类型模板参数，如 template <int N>
  readability-identifier-naming.FunctionCase:                     CamelCase
  readability-identifier-naming.MemberCase:                       CamelCase
  readability-identifier-naming.MemberPrefix:                     ''
  readability-identifier-naming.MemberSuffix:                     ''
  readability-identifier-naming.PublicMemberCase:                 CamelCase
  readability-identifier-naming.PublicMemberPrefix:               ''
  readability-identifier-naming.PublicMemberSuffix:               ''
  readability-identifier-naming.PrivateMemberCase:                CamelCase
  readability-identifier-naming.PrivateMemberPrefix:              ''
  readability-identifier-naming.PrivateMemberSuffix:              ''
  readability-identifier-naming.ParameterCase:                    camelBack
  readability-identifier-naming.VariableCase:                     camelBack
  readability-identifier-naming.GlobalVariableCase:               CamelCase
  readability-identifier-naming.GlobalVariablePrefix:             g
  # 常量统一使用 kCamelCase
  readability-identifier-naming.ConstexprVariableCase:            CamelCase
  readability-identifier-naming.ConstexprVariablePrefix:          k
  readability-identifier-naming.GlobalConstantCase:               CamelCase
  readability-identifier-naming.GlobalConstantPrefix:             k
  readability-identifier-naming.ClassConstantCase:                CamelCase
  readability-identifier-naming.ClassConstantPrefix:              k
  readability-identifier-naming.StaticConstantCase:               CamelCase
  readability-identifier-naming.StaticConstantPrefix:             k
  readability-identifier-naming.IgnoreMainLikeFunctions:          1
  readability-redundant-member-init.IgnoreBaseInCopyConstructors: 1
  # 别名检查必须与本体配置一致，否则两者给出的 fix-it 冲突，clang-tidy 会拒绝应用
  modernize-use-default-member-init.UseAssignment:                1
  cppcoreguidelines-use-default-member-init.UseAssignment:        1
  readability-qualified-auto.AddConstToQualified:                 true
